# Server Environment Configuration Template
# Copy to .env and configure local values

# Application Runtime
NODE_ENV=development
PORT=5000

# Security & CORS Whitelist
CLIENT_ORIGIN=http://localhost:5173

# Logging Level (dev, combined, common, short, tiny)
LOG_LEVEL=dev

# Planned Database & Auth (Uncomment in Future Prompts)
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/sastomarts
# JWT_SECRET=your_jwt_secret_key_minimum_32_characters
# JWT_EXPIRES_IN=7d
