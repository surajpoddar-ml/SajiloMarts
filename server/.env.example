# Server Environment Configuration Template
# Copy to .env and configure local values

# Application Runtime
NODE_ENV=development
PORT=5000

# Security & CORS Whitelist
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
API_PREFIX=/api/v1

# Logging Level (dev, combined, common, short, tiny)
LOG_LEVEL=dev

# Canonical MongoDB Connection URI (Atlas or Local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/sastomarts?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/sastomarts

# Authentication & Session Security (Required in production)
JWT_SECRET=your_jwt_signing_secret_min_32_characters_long
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d
AUTH_COOKIE_MAX_AGE_MS=604800000
